// Surface overlay for elemental status effects, drawn by QuietElements over a creature's skinned mesh.
// The look lives in ElementalOverlay.cginc, generated by tools/gen.py from src/overlay.glsl and src/params.json
// (the browser preview uses the same source). This file only wires it into three passes:
//   0 tint (multiply), 1 light (add), 2 shell: one layer floating above the skin, drawn ShellCount times.
Shader "Hidden/ElementalOverlay"
{
    CGINCLUDE
    #include "UnityCG.cginc"
    #include "ElementalOverlay.cginc"

    // Set by the mod per creature / per draw.
    float _ElemScale;    // 1 for a Greydwarf, smaller for big creatures so patterns aren't busy
    sampler2D _ElemMask; // creature material texture: alpha cutout for fur cards, and albedo for cast light
    float _ShellH;       // 0..1 layer position for the shell pass

    struct appdata { float4 vertex : POSITION; float3 normal : NORMAL; float2 uv : TEXCOORD0; };
    struct v2f
    {
        float4 pos : SV_POSITION;
        float3 p : TEXCOORD0;  // object space in metres
        float3 n : TEXCOORD1;
        float3 wp : TEXCOORD2;
        float2 uv : TEXCOORD3;
    };

    v2f vertAt(appdata i, float lift)
    {
        v2f o;
        float3 scale = float3(length(unity_ObjectToWorld._m00_m10_m20), length(unity_ObjectToWorld._m01_m11_m21), length(unity_ObjectToWorld._m02_m12_m22));
        float3 wn = UnityObjectToWorldNormal(i.normal);
        float4 wp = mul(unity_ObjectToWorld, i.vertex);
        wp.xyz += wn * lift;
        o.pos = mul(UNITY_MATRIX_VP, wp);
        o.p = i.vertex.xyz * scale;
        o.n = wn;
        o.wp = wp.xyz;
        o.uv = i.uv;
        return o;
    }

    v2f vert(appdata i) { return vertAt(i, 0.004); } // lift off the skin to avoid z-fighting
    v2f vertShell(appdata i) { return vertAt(i, 0.004 + _ShellH * _GlobalShellHeight / max(_ElemScale, 0.05)); }

    void Prep(v2f i, out float3 p, out float3 n, out float3 nf, out float3 v, out float pw, out float3 alb)
    {
        float4 tex = tex2D(_ElemMask, i.uv); // the creature's own texture: alpha cutout and albedo for cast light
        if (_ElemCutoff >= 0) clip(tex.a - _ElemCutoff);
        alb = tex.rgb;
        p = i.p * _ElemScale;
        pw = length(fwidth(p));
        n = normalize(i.n);
        v = normalize(_WorldSpaceCameraPos - i.wp);
        nf = normalize(cross(ddy(i.wp), ddx(i.wp)));
        if (dot(nf, v) < 0) nf = -nf;
    }

    // ponytail: passes 0 and 1 each evaluate the full overlay (2x ALU per covered pixel); fine for a handful of
    // creatures, bake the noise into a 3D texture if crowds of burning enemies ever show up in a profile.
    float4 fragMul(v2f i) : SV_Target { float3 p, n, nf, v, alb; float pw; Prep(i, p, n, nf, v, pw, alb); float3 m, a; overlay(p, n, nf, v, pw, alb, m, a); return float4(m, 1); }
    float4 fragAdd(v2f i) : SV_Target { float3 p, n, nf, v, alb; float pw; Prep(i, p, n, nf, v, pw, alb); float3 m, a; overlay(p, n, nf, v, pw, alb, m, a); return float4(a, 1); }
    float4 fragShell(v2f i) : SV_Target { float3 p, n, nf, v, alb; float pw; Prep(i, p, n, nf, v, pw, alb); float3 c; float al; shell(p, n, nf, v, pw, _ShellH, c, al); return float4(c, al); }
    ENDCG

    SubShader
    {
        Tags { "Queue" = "Transparent+50" "RenderType" = "Transparent" "IgnoreProjector" = "True" }
        ZWrite Off
        ZTest LEqual
        Cull Back

        Pass // 0 tint: soot, cold, crust, hollow
        {
            Offset -1, -1
            Blend DstColor Zero
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment fragMul
            #pragma target 3.5
            ENDCG
        }

        Pass // 1 light: seams, rime, veins, arcs, rim
        {
            Offset -1, -1
            Blend One One
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment fragAdd
            #pragma target 3.5
            ENDCG
        }

        Pass // 2 shell: flames, ice coat, haze, arcs, aura above the skin (premultiplied)
        {
            Blend One OneMinusSrcAlpha
            CGPROGRAM
            #pragma vertex vertShell
            #pragma fragment fragShell
            #pragma target 3.5
            ENDCG
        }
    }
}
