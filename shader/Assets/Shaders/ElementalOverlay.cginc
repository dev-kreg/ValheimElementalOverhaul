// Elemental overlay: shared source for the Unity shader and the browser preview.
// Written in a GLSL subset that tools/gen.py translates to HLSL (vecN->floatN, mix->lerp, fract->frac,
// inversesqrt->rsqrt, dFdx/dFdy->ddx/ddy). Rules: no single-argument vector constructors (use v3()),
// no mod(), no texture sampling. Uniforms come from params.json (_<Section><Name>) plus the engine inputs:
//   _ElemA (fire, frost, poison, lightning levels), _ElemB (spirit), _ElemAge/_ElemAgeB (seconds active),
//   _ElemLight (scene light 0..1), _ElemCutoff (>= 0 on alpha-cutout fur), _ElemSunDir, uTime.
// Each element owns a channel so stacks still read: frost = surface tint/crust, fire = seams + silhouette,
// poison = veins/bubbles, lightning = intermittent arcs, spirit = rim/hollow.

float3 v3(float x) { return float3(x, x, x); }

float h3(float3 p) { p = frac(p * .3183099 + .1); p *= 17.; return frac(p.x * p.y * p.z * (p.x + p.y + p.z)); }

float vn3(float3 x) {
  float3 i = floor(x); float3 f = frac(x); f = f * f * (3. - 2. * f);
  return lerp(lerp(lerp(h3(i), h3(i + float3(1., 0., 0.)), f.x), lerp(h3(i + float3(0., 1., 0.)), h3(i + float3(1., 1., 0.)), f.x), f.y),
             lerp(lerp(h3(i + float3(0., 0., 1.)), h3(i + float3(1., 0., 1.)), f.x), lerp(h3(i + float3(0., 1., 1.)), h3(i + float3(1., 1., 1.)), f.x), f.y), f.z);
}

float fbm3(float3 p) { return vn3(p) * .5 + vn3(p * 2.03) * .3 + vn3(p * 4.01) * .2; }

// Distance (in x units) to the 0.5 contour, from a finite-difference gradient. Value noise piles up near 0.5,
// so "abs(n - .5) < w" makes fat blobs where the noise is flat; dividing by the gradient keeps lines thin.
float isoDist(float3 x) {
  float v = vn3(x); float e = .03;
  float3 g = float3(vn3(x + float3(e, 0., 0.)) - v, vn3(x + float3(0., e, 0.)) - v, vn3(x + float3(0., 0., e)) - v) / e;
  return abs(v - .5) / max(length(g), .05);
}
float isoDistFbm(float3 x) {
  float v = fbm3(x); float e = .03;
  float3 g = float3(fbm3(x + float3(e, 0., 0.)) - v, fbm3(x + float3(0., e, 0.)) - v, fbm3(x + float3(0., 0., e)) - v) / e;
  return abs(v - .5) / max(length(g), .05);
}

// distance to nearest and second-nearest cell point; F2-F1 gives crystal edges
float2 vor(float3 x) {
  float3 i = floor(x); float3 f = frac(x); float d1 = 8.; float d2 = 8.;
  for (int z = -1; z <= 1; z++) for (int y = -1; y <= 1; y++) for (int k = -1; k <= 1; k++) {
    float3 g = float3(float(k), float(y), float(z));
    float3 o = float3(h3(i + g), h3(i + g + 17.1), h3(i + g + 31.7));
    float3 r = g + o - f; float d = dot(r, r);
    if (d < d1) { d2 = d1; d1 = d; } else if (d < d2) { d2 = d; }
  }
  return float2(sqrt(d1), sqrt(d2));
}

float3 fireRamp(float t) {
  float3 c = lerp(v3(0.), _FireCoolColor, smoothstep(0., .3, t));
  c = lerp(c, _FireMidColor * _FireGlow, smoothstep(.3, .65, t));
  return lerp(c, _FireHotColor * _FireGlow, smoothstep(.65, 1., t));
}

float rimDamp() { return _ElemCutoff >= 0. ? .25 : 1.; } // edge-on fur cards stack rim effects into a blob

float stackDim() {
  float n = step(.01, _ElemA.x) + step(.01, _ElemA.y) + step(.01, _ElemA.z) + step(.01, _ElemA.w) + step(.01, _ElemB);
  return lerp(1., rsqrt(max(n, 1.)), _GlobalStackDim);
}

float frostCover(float3 q, float3 n) {
  float spread = _FrostSpread > .001 ? clamp(_ElemAge.y / _FrostSpread, 0., 1.) : 1.;
  float lo = .7 - .6 * _FrostCoverage * spread;
  return smoothstep(lo, lo + .18, fbm3(q * 3.1) + n.y * .3);
}

// lightning burst gate: same hash on the CPU drives the light flash
float lightningOn(float t) {
  float burst = step(1. - _LightningBurstChance, h3(float3(floor(t * _LightningBurstRate), 1.3, 2.1)));
  return burst * step(.25, h3(float3(floor(t * _LightningFlickerRate), .37, .71)));
}


float mod5(float x) { return x - 5. * floor(x / 5.); }

// ---------------- combos ----------------
// Pair ids: 1 Steam (fire+frost), 2 Overload (fire+lightning), 3 ToxicBurn (fire+poison), 4 GhostFire (fire+spirit),
// 5 ConductiveIce (frost+lightning), 6 FrozenVeins (frost+poison), 7 WraithChill (frost+spirit),
// 8 CorrosiveSparks (lightning+poison), 9 SoulLightning (lightning+spirit), 10 Blight (poison+spirit).
// A pair's weight is the weaker of its two levels; the strongest enabled pair wins. All five on = Ragnarok.
void comboPick(out float id, out float w, out float allW) {
  float f = _ElemA.x; float r = _ElemA.y; float po = _ElemA.z; float l = _ElemA.w; float s = _ElemB;
  float on = _CombosEnabled;
  allW = min(min(min(f, r), min(po, l)), s) * _CombosAllEnabled * on;
  id = 0.; w = 0.; float c = 0.;
  c = min(f, r) * _CombosSteamEnabled * on;            if (c > w + .001) { w = c; id = 1.; }
  c = min(f, l) * _CombosOverloadEnabled * on;         if (c > w + .001) { w = c; id = 2.; }
  c = min(f, po) * _CombosToxicBurnEnabled * on;       if (c > w + .001) { w = c; id = 3.; }
  c = min(f, s) * _CombosGhostFireEnabled * on;        if (c > w + .001) { w = c; id = 4.; }
  c = min(r, l) * _CombosConductiveIceEnabled * on;    if (c > w + .001) { w = c; id = 5.; }
  c = min(r, po) * _CombosFrozenVeinsEnabled * on;     if (c > w + .001) { w = c; id = 6.; }
  c = min(r, s) * _CombosWraithChillEnabled * on;      if (c > w + .001) { w = c; id = 7.; }
  c = min(l, po) * _CombosCorrosiveSparksEnabled * on; if (c > w + .001) { w = c; id = 8.; }
  c = min(l, s) * _CombosSoulLightningEnabled * on;    if (c > w + .001) { w = c; id = 9.; }
  c = min(po, s) * _CombosBlightEnabled * on;          if (c > w + .001) { w = c; id = 10.; }
  if (allW > .001) { id = 0.; w = 0.; } // Ragnarok takes over
}

// 1 when element e (0 fire, 1 frost, 2 poison, 3 lightning, 4 spirit) belongs to pair id
float pairHas(float id, float e) {
  float a = -1.; float b = -1.;
  if (id == 1.) { a = 0.; b = 1.; } else if (id == 2.) { a = 0.; b = 3.; } else if (id == 3.) { a = 0.; b = 2.; }
  else if (id == 4.) { a = 0.; b = 4.; } else if (id == 5.) { a = 1.; b = 3.; } else if (id == 6.) { a = 1.; b = 2.; }
  else if (id == 7.) { a = 1.; b = 4.; } else if (id == 8.) { a = 3.; b = 2.; } else if (id == 9.) { a = 3.; b = 4.; }
  else if (id == 10.) { a = 2.; b = 4.; }
  return (a == e || b == e) ? 1. : 0.;
}

// how much of element e's own look survives the active combo
float keep(float id, float w, float allW, float e) { return 1. - _CombosReplace * max(allW, w * pairHas(id, e)); }

// thin arcs (lightning-style) gated at rate hz, in colour col
float arcLines(float3 q, float t, float hz, float pw, float seed) {
  float s = floor(t * hz);
  float3 jag = (float3(vn3(q * 11. + s), vn3(q * 11. + s + 4.), vn3(q * 11. + s + 8.)) - .5) * .4;
  float aw = .004 + pw * 1.5;
  float arc = 1. - smoothstep(aw * .4, aw, isoDist(q * 2.6 + s * 3.1 + seed + jag) / 2.6);
  return arc * smoothstep(.6, .68, vn3(q * 1.1 + s * 7.3 + seed));
}

float3 elemColor(float i) {
  if (i < .5) return _FireMidColor;
  if (i < 1.5) return _FrostRimColor;
  if (i < 2.5) return _PoisonVeinColor;
  if (i < 3.5) return _LightningArcColor;
  return _SpiritColor;
}

void comboSkin(float id, float w, float allW, float3 p, float3 q, float3 n, float3 v, float pw, float3 alb, float fres, float t,
               inout float3 mulc, inout float3 addc) {
  float L = _ElemLight;
  float3 hv = normalize(_ElemSunDir + v);
  if (id == 1.) { // Steam
    float k = w * _CombosSteamStrength; float3 c = _CombosSteamColor;
    float vapor = smoothstep(.55, .8, fbm3(q * 2.5 + float3(0., -t * 1.2, 0.))) * (.4 + .6 * fres);
    float spec = pow(clamp(dot(n, hv), 0., 1.), 40.) * (.3 + .7 * L);
    mulc *= lerp(v3(1.), v3(.82), k * .35);                                 // wet, darker skin
    addc += (c * (.12 + .45 * L) * vapor + c * spec * .7) * k;
    addc += _FireMidColor * .3 * smoothstep(.68, .82, fbm3(q * 3. + float3(0., -t * .5, 0.))) * k;   // faint ember core
  } else if (id == 2.) { // Overload
    float k = w * _CombosOverloadStrength; float3 c = _CombosOverloadColor;
    float on = step(.3, h3(float3(floor(t * 18.), .11, .53)));
    addc += lerp(c, v3(1.), .35) * 2.5 * arcLines(q, t, 18., pw, 1.7) * on * k;
    addc += c * pow(fres, 2.) * (.15 + .35 * on) * k;
    mulc *= lerp(v3(1.), float3(.5, .42, .38), k * .5);                        // scorched
  } else if (id == 3.) { // Toxic burn
    float k = w * _CombosToxicBurnStrength; float3 c = _CombosToxicBurnColor;
    float n2 = fbm3(q * 3.2 + float3(0., -t * 1.4, 0.));
    float lick = smoothstep(.5, .8, n2) * smoothstep(.5, .95, fres);
    float tar = smoothstep(.5, .7, fbm3(q * 2. + float3(0., -t * .2, 0.)));
    mulc *= lerp(v3(1.), float3(.22, .28, .15), (.35 + .65 * tar) * k * .85);  // green-black tar over most of the body
    addc += lerp(c, float3(1., .9, .3), .3) * lick * .9 * k;
    addc += c * .22 * smoothstep(.66, .82, n2) * (1. - tar) * k;
  } else if (id == 4.) { // Ghost fire
    float k = w * _CombosGhostFireStrength; float3 c = _CombosGhostFireColor;
    float n2 = fbm3(q * 3.6 + float3(0., -t * 1.8, 0.));
    float lick = smoothstep(.5, .8, n2) * smoothstep(.45, .95, fres);
    float glow = smoothstep(.62, .82, fbm3(q * 1.6 + float3(0., -t * .4, 0.)));
    mulc *= lerp(v3(1.), float3(.6, .7, .8), k * .5);                          // cold, pale
    addc += (lerp(c, v3(1.), lick * .5) * lick * 1.8 + c * glow * .4) * k;
  } else if (id == 5.) { // Conductive ice: arcs run along the ice cracks
    float k = w * _CombosConductiveIceStrength; float3 c = _CombosConductiveIceColor;
    float2 cc = vor(q * _FrostCrackScale);
    float edge = 1. - smoothstep(0., .05 + pw * 4., cc.y - cc.x);
    float s = floor(t * 14.);
    float flash = step(.45, h3(float3(s, .3, .9))) * smoothstep(.45, .6, vn3(q * 1.4 + s * 5.1));
    addc += c * edge * (.12 + 2.6 * flash) * k;
  } else if (id == 6.) { // Frozen veins
    float k = w * _CombosFrozenVeinsStrength; float3 c = _CombosFrozenVeinsColor;
    float3 w3 = q * 3. + float3(fbm3(q * 1.7), fbm3(q * 1.7 + 5.2), fbm3(q * 1.7 + 9.1)) * 1.4;
    float vd = isoDistFbm(w3) / 3.;
    float vein = 1. - smoothstep(.01 + pw, .025 + pw, vd);
    float halo = 1. - smoothstep(.02, .06, vd);
    mulc *= lerp(v3(1.), c * .7, vein * k);                                  // dark crystallised veins
    addc += _FrostRimColor * (halo - vein) * (.1 + .25 * L) * k;           // icy rim around each vein
  } else if (id == 7.) { // Wraith chill: colour drains away
    float k = w * _CombosWraithChillStrength; float3 c = _CombosWraithChillColor;
    float grey = dot(alb, float3(.3, .59, .11));
    mulc *= lerp(v3(1.), v3(.45), k * .7);
    addc += c * grey * (.12 + .45 * L) * k;
    addc += c * pow(fres, 2.5) * .5 * k;
  } else if (id == 8.) { // Corrosive sparks
    float k = w * _CombosCorrosiveSparksStrength; float3 c = _CombosCorrosiveSparksColor;
    float on = lightningOn(t);
    addc += c * 2.2 * arcLines(q, t, _LightningFlickerRate, pw, 4.4) * on * k;
    float3 bc = floor(q * 14.); float bh = h3(bc); float ph = frac(t * .8 + bh * 7.);
    float br = length(frac(q * 14.) - .5);
    float pop = (1. - smoothstep(0., .08, abs(br - ph * .45))) * step(.8, bh) * (1. - ph);
    addc += lerp(c, v3(1.), .5) * pop * 1.2 * k;                             // sizzling bubbles
  } else if (id == 9.) { // Soul lightning: arcs leave fading trails
    float k = w * _CombosSoulLightningStrength; float3 c = _CombosSoulLightningColor;
    float hz = _LightningFlickerRate * .7;
    float now = arcLines(q, t, hz, pw, 2.2);
    float prev = arcLines(q, t - 1. / hz, hz, pw * 2.5, 2.2);
    float prev2 = arcLines(q, t - 2. / hz, hz, pw * 4., 2.2);
    addc += c * (2.2 * now + .7 * prev + .25 * prev2) * k;
    addc += c * pow(fres, 3.) * .4 * k;
  } else if (id == 10.) { // Blight: decay creeps over the skin
    float k = w * _CombosBlightStrength; float3 c = _CombosBlightColor;
    float spread = clamp(max(_ElemAge.z, _ElemAge.w) / 6., .25, 1.);
    float lo = .68 - .3 * spread;
    float bl = fbm3(q * 2. + float3(0., 0., t * .03));
    float patch_ = smoothstep(lo, lo + .06, bl);
    float rim = smoothstep(lo - .05, lo, bl) * (1. - patch_);
    mulc *= lerp(v3(1.), c * .55, patch_ * k);
    addc += (float3(.35, .8, .2) * rim * .6 + c * pow(fres, 2.) * .35) * k;
  }

  if (allW > .001) { // Ragnarok: a darkened body split by fractures cycling through every element's colour
    float k = allW * _CombosAllStrength;
    float2 cc = vor(q * 6.);
    float frac_ = 1. - smoothstep(0., .04 + pw * 4., cc.y - cc.x);
    float cyc = frac(t * _CombosAllCycleSpeed + p.y * .25 + cc.x * .3) * 5.;
    float3 col = lerp(elemColor(floor(cyc)), elemColor(mod5(floor(cyc) + 1.)), frac(cyc));
    col = lerp(col, _CombosAllColor, .35);
    float ring = 1. - smoothstep(0., .06, abs(frac(p.y * .6 - t * .5) - .5));     // shockwaves rising up the body
    float pulse = .7 + .3 * sin(t * 3.);
    mulc *= lerp(v3(1.), v3(.25), k * .75);
    addc += col * _CombosAllGlow * (frac_ * pulse + ring * .5) * k;
    addc += col * pow(fres, 2.) * .8 * k;
  }
}

void comboShell(float id, float w, float allW, float3 q, float3 n, float3 v, float pw, float fres, float t, float h,
                inout float3 col, inout float alpha) {
  float fade = 1. - h; float L = _ElemLight;
  if (id == 1.) { // Steam clouds rising off the body
    float k = w * _CombosSteamStrength;
    float m = smoothstep(.5, .78, fbm3(q * float3(2., 1., 2.) + float3(0., -t * 1.5 - h * 1.2, 0.))) * fade * (.35 + .65 * fres);
    col += _CombosSteamColor * (.12 + .45 * L) * m * k; alpha = max(alpha, m * .35 * k);
  } else if (id == 2. || id == 8.) { // stray arcs in the air
    float k = w * (id == 2. ? _CombosOverloadStrength : _CombosCorrosiveSparksStrength);
    float3 c = id == 2. ? _CombosOverloadColor : _CombosCorrosiveSparksColor;
    col += c * 2. * arcLines(q * 1.3 + h * 3., t, 18., pw, 9.) * fade * k;
  } else if (id == 3.) { // green-black smoke flames (premultiplied: dark smoke occludes)
    float k = w * _CombosToxicBurnStrength;
    float m = smoothstep(.55, .75, fbm3(q * float3(3., 1.6, 3.) + float3(0., -t * 2. - h * .9, 0.))) * smoothstep(-.3, .5, n.y) * fade;
    col += _CombosToxicBurnColor * .5 * m * k; alpha = max(alpha, m * .45 * k);
  } else if (id == 4.) { // pale ghost-fire tongues
    float k = w * _CombosGhostFireStrength;
    float m = smoothstep(.55 + h * .2, .7 + h * .2, fbm3(q * float3(3., 1.6, 3.) + float3(0., -t * 2.4 - h * .9, 0.)))
              * smoothstep(-.3, .5, n.y) * lerp(.15, 1., smoothstep(.25, .85, fres));
    col += lerp(_CombosGhostFireColor, v3(1.), (1. - h) * .4) * 1.4 * m * (1. - h * .5) * k;
  } else if (id == 7. || id == 6. || id == 10.) { // mist / haze
    float k = w * (id == 7. ? _CombosWraithChillStrength : id == 6. ? _CombosFrozenVeinsStrength : _CombosBlightStrength);
    float3 c = id == 7. ? _CombosWraithChillColor : id == 6. ? _FrostCrustColor : _CombosBlightColor;
    float m = smoothstep(.5, .8, fbm3(q * 1.5 + float3(t * .1, -t * .2, 0.))) * fade * fade * (.3 + .7 * fres);
    col += c * (.1 + .3 * L) * m * k; alpha = max(alpha, m * .25 * k);
  } else if (id == 9.) { // soul wisps
    float k = w * _CombosSoulLightningStrength;
    float m = smoothstep(.62, .85, fbm3(q * 2. + float3(0., -t * 1.4, 0.))) * smoothstep(.3, .9, fres) * fade;
    col += _CombosSoulLightningColor * m * .6 * k;
  }
  if (allW > .001) { // Ragnarok aura: swirling colours
    float k = allW * _CombosAllStrength;
    float sw = fbm3(q * 1.8 + float3(sin(t * .7) * .5, -t * .9 - h, cos(t * .7) * .5));
    float cyc = frac(t * _CombosAllCycleSpeed + sw) * 5.;
    float3 c = lerp(elemColor(floor(cyc)), elemColor(mod5(floor(cyc) + 1.)), frac(cyc));
    float m = smoothstep(.55, .8, sw) * fade * (.25 + .75 * fres);
    col += lerp(c, _CombosAllColor, .3) * m * _CombosAllGlow * .6 * k;
  }
}

// p: object space in metres (already scaled by creature size), n: smooth world normal, nf: flat (faceted) world normal,
// v: direction to camera, pw: metres per pixel at p, alb: the creature's own surface colour (for cast light).
void overlay(float3 p, float3 n, float3 nf, float3 v, float pw, float3 alb, out float3 mulc, out float3 addc) {
  n = normalize(lerp(n, nf, _GlobalFlatNormals));   // some game meshes ship odd normals; geometry normals can't be wrong
  float fres = (1. - clamp(dot(n, v), 0., 1.)) * rimDamp();
  float t = uTime;
  mulc = v3(1.); addc = v3(0.);
  float3 addL = v3(0.);
  float cid; float cw; float aw; comboPick(cid, cw, aw);
  float fire = _ElemA.x * keep(cid, cw, aw, 0.); float frost = _ElemA.y * keep(cid, cw, aw, 1.);
  float poison = _ElemA.z * keep(cid, cw, aw, 2.); float lightning = _ElemA.w * keep(cid, cw, aw, 3.); float spirit = _ElemB * keep(cid, cw, aw, 4.);
  float dim = stackDim();
  float3 q = p / _GlobalPatternScale;
  float pwq = pw / _GlobalPatternScale;

  if (fire > .001) {
    float3 qf = q * _FireNoiseScale; float rs = t * _FireRiseSpeed;
    float n1 = fbm3(qf * 2.2 + float3(0., -rs * .8, 0.));
    float n2 = fbm3(qf * 4.6 + float3(0., -rs * 1.6, 0.) + v3(n1 * 1.5));          // two scales, two speeds: no visible tiling
    float flick = 1. - _FireFlickerAmount + _FireFlickerAmount * sin(t * _FireFlickerSpeed + n1 * 7.);
    float I = fire * _FireIntensity * dim;
    // char spreads the longer it burns
    float charT = _FireCharBuildUp > .001 ? clamp(_ElemAge.x / _FireCharBuildUp, 0., 1.) : 1.;
    float charMask = smoothstep(.6 - .2 * charT, .7, n1);
    float soot = _FireSootAmount * fire * charT * charMask;
    // smoulder: soft heat patches glowing through the char, slowly rising and breathing
    float heat = fbm3(qf * 1.6 * _FireSmolderScale + float3(0., -rs * .35, t * .05));
    float breathe = .75 + .25 * sin(t * 1.3 + heat * 9.);
    float smolder = smoothstep(.6, .82, heat) * breathe * (.3 + .7 * charMask);
    addc += fireRamp(smolder * .62) * smolder * _FireSmolder * I;
    // firelight: the flames light the body's own colours, warm and flickering, more on the lower half
    addc += alb * _FireMidColor * (.6 + .4 * clamp(-n.y + .3, 0., 1.)) * flick * _FireFirelight * (1. - .6 * _ElemLight) * I;
    // flames licking at the silhouette
    float lick = smoothstep(.5, .8, n2) * smoothstep(.55, .95, fres) * smoothstep(-.4, .4, n.y + .2);
    addc += fireRamp(clamp(lick, 0., 1.)) * lick * _FireLickAmount * flick * I;
    // round ember spots that flicker in the char (cell points, not grid squares)
    if (_FireEmbers > .001) {
      float2 ce = vor(qf * 7. + float3(0., -rs * .2, 0.));
      float spot = 1. - smoothstep(.06, .16 + pw * 7., ce.x);
      float tw = .5 + .5 * sin(t * 4. + vn3(qf * 7.) * 30.);
      addc += fireRamp(.8) * spot * tw * soot * smoothstep(.55, .7, vn3(qf * 2.3 + 11.)) * _FireEmbers * I;
    }
    // optional glowing seams (off by default)
    if (_FireSeamAmount > .001) {
      float sd = isoDist(qf * 3.4 + float3(0., -rs * .45, 0.) + v3(n1 * 1.2)) / (3.4 * _FireNoiseScale);
      float sw = .006 + .03 * _FireSeamWidth + pw;
      float crack = (1. - smoothstep(sw * .4, sw, sd)) * smoothstep(.4, .6, n2);
      addc += fireRamp(crack * .9) * crack * _FireSeamAmount * flick * I;
      soot *= 1. - crack;
    }
    mulc *= lerp(v3(1.), _FireSootColor, soot);
  }

  if (frost > .001) {
    float cover = frostCover(q, n) * frost;
    float2 c = vor(q * _FrostCrackScale);
    float edge = 1. - smoothstep(0., _FrostCrackWidth, c.y - c.x);
    // faceted crystal shading: flat normals against a fixed key light read as chunky ice
    float facet = lerp(1., .55 + .9 * clamp(dot(nf, normalize(float3(.3, .8, -.5))), 0., 1.), _FrostFacets);
    mulc *= lerp(v3(1.), _FrostTintColor, frost * _FrostTintAmount);
    mulc *= lerp(v3(1.), _FrostCrustColor * _FrostCrustBoost * facet, cover * .7);
    addc += _FrostCrustColor * cover * facet * (.04 + .1 * _ElemLight + edge * _FrostCrackAmount * (.08 + .25 * _ElemLight)) * _FrostIntensity * dim;
    addc += _FrostRimColor * pow(fres, 1.6) * frost * (.06 + .15 * _ElemLight) * _FrostRimAmount * _FrostIntensity * dim;
    float gc = h3(floor(p * _FrostGlintSize));
    float tw = step(1. - _FrostGlintDensity, gc) * (.5 + .5 * sin(t * 2.5 + gc * 60.));
    addc += float3(1.4, 1.7, 2.1) * tw * cover * _FrostGlintAmount * _FrostIntensity * (.4 + .6 * pow(clamp(dot(nf, v), 0., 1.), 4.));
  }

  if (poison > .001) {
    float3 qp = q * (_PoisonVeinScale / 3.);
    float3 w = qp * 3. + float3(fbm3(qp * 1.7), fbm3(qp * 1.7 + 5.2), fbm3(qp * 1.7 + 9.1)) * 1.4;   // warp so veins wander
    float vc = .65 - .5 * _PoisonVeinCoverage;
    float vd = isoDistFbm(w) / (3. * _PoisonVeinScale / 3.);                   // metres to the vein centre
    float vw = _PoisonVeinWidth * .5 + pw;
    float vein = (1. - smoothstep(vw * .4, vw, vd)) * smoothstep(vc, vc + .2, fbm3(qp * 1.3 + 3.3));
    float pulse = pow(.5 + .5 * sin(t * _PoisonPulseSpeed - p.y * _PoisonPulseTravel), _PoisonPulseSharpness);
    // bubbles: rings that swell from a point and pop
    float3 bc = floor(q * 14.); float bh = h3(bc); float ph = frac(t * .35 + bh * 7.);
    float br = length(frac(q * 14.) - .5);
    float bub = (1. - smoothstep(0., .06, abs(br - ph * .45))) * step(.85, bh) * (1. - ph);
    float3 hv = normalize(_ElemSunDir + v);
    float spec = pow(clamp(dot(n, hv), 0., 1.), 24.) * (.2 + .8 * _ElemLight);
    mulc *= lerp(v3(1.), _PoisonTintColor, poison * _PoisonTintAmount);
    addc += _PoisonVeinColor * _PoisonGlow * (vein * (.12 + .7 * pulse) + bub * _PoisonBubbles * .8) * poison * _PoisonIntensity * dim;
    addc += _PoisonVeinColor * (pow(fres, 2.) * (.15 + .4 * _ElemLight) * .6 + spec * .8) * _PoisonSheenAmount * poison * dim;
  }

  if (lightning > .001) {
    float on = lightningOn(t);
    float s = floor(t * _LightningFlickerRate);
    float3 ql = q + float3(0., t * _LightningCrawl, 0.);   // crawl: arcs slide over the body
    float3 jag = (float3(vn3(ql * 11. + s), vn3(ql * 11. + s + 4.), vn3(ql * 11. + s + 8.)) - .5) * _LightningJagged;
    float sc = _LightningArcScale;
    float3 a1 = ql * sc + s * 3.1 + jag; float3 a2 = ql * sc * 2.4 + s * 1.7 + jag * 1.5;
    float f1 = vn3(a1);
    float zlo = lerp(.85, .35, _LightningArcDensity);
    float zone = smoothstep(zlo, zlo + .08, vn3(ql * 1.1 + s * 7.3));        // only a few regions spark per flash
    // thin lines of constant width in metres (at least ~1.5 px), chunky like the game's spark sprites
    float aw = (.004 + pwq * 1.5) * _LightningArcWidth;
    float arc = 1. - smoothstep(aw * .4, aw, isoDist(a1) / sc);
    arc += _LightningBranches * (1. - smoothstep(aw * .3, aw * .7, isoDist(a2) / (sc * 2.4))) * smoothstep(.42, .5, f1);
    addL += _LightningArcColor * _LightningGlow * arc * zone * on * lightning * _LightningIntensity;
    addL += _LightningRimColor * pow(fres, 2.) * lightning * (.06 + on * .35) * _LightningRimAmount * _LightningIntensity;
  }

  if (spirit > .001) {
    float wisp = smoothstep(.62, .85, fbm3(q * 2.4 + float3(0., -t * _SpiritWispSpeed, 0.))) * smoothstep(.45, .9, fres);
    mulc *= lerp(v3(1.), _SpiritTintColor, spirit * _SpiritTintAmount);
    mulc *= lerp(v3(1.), v3(1. - _SpiritHollow), spirit * (1. - fres));        // hollow: interior darkens, edges stay lit
    addc += _SpiritColor * (pow(fres, _SpiritRimPower) * .3 * _SpiritRimAmount + wisp * .7 * _SpiritWispAmount) * spirit * _SpiritIntensity * dim;
  }

  addc += addL;
  comboSkin(cid, cw, aw, p, q, n, v, pwq, alb, fres, t, mulc, addc);
  addc *= _GlobalStrength;
}

// Layers floating above the skin. h: 0 at the skin, 1 at the outermost layer. Premultiplied output.
void shell(float3 p, float3 n, float3 nf, float3 v, float pw, float h, out float3 col, out float alpha) {
  n = normalize(lerp(n, nf, _GlobalFlatNormals));
  float fres = (1. - clamp(dot(n, v), 0., 1.)) * rimDamp();
  float t = uTime;
  col = v3(0.); alpha = 0.;
  float cid; float cw; float aw; comboPick(cid, cw, aw);
  float fire = _ElemA.x * keep(cid, cw, aw, 0.); float frost = _ElemA.y * keep(cid, cw, aw, 1.);
  float poison = _ElemA.z * keep(cid, cw, aw, 2.); float lightning = _ElemA.w * keep(cid, cw, aw, 3.); float spirit = _ElemB * keep(cid, cw, aw, 4.);
  float fade = 1. - h;
  float3 q = p / _GlobalPatternScale;

  if (fire > .001) {
    // vertically stretched noise rising fast: tongues that taper with height
    float3 qf = q * _FireNoiseScale;
    // outer layers sample the noise further down the rising flow, so a tongue continues outward and upward
    // instead of each layer repeating the same shape
    float fl = fbm3(qf * float3(3., 1.6, 3.) + float3(0., -t * _FireRiseSpeed * 2.2 - h * .9, 0.));
    float up = smoothstep(-.3, .5, n.y);
    float edge = lerp(.15, 1., smoothstep(.25, .85, fres));   // face-on layers stack into a sheet: favour the silhouette
    float m = smoothstep(.56 + h * .2, .72 + h * .2, fl) * up * edge;   // sparse tongues that thin out with height
    col += fireRamp(clamp((1. - h * .6) * m, 0., 1.)) * m * (1. - h * .5) * _FireShellFlames * fire * _FireIntensity * .7;
  }
  if (frost > .001) {
    float a = frostCover(q, n) * frost * _FrostShellIce * fade * fade * .45;
    col += (_FrostCrustColor * (.12 + .45 * _ElemLight) + _FrostRimColor * pow(fres, 1.5) * .8) * a * _FrostIntensity;
    alpha = max(alpha, a * .5);
  }
  if (poison > .001) {
    float hz = smoothstep(.55, .8, fbm3(q * 1.5 + float3(0., -t * .25, 0.))) * fade * lerp(.3, 1., fres);
    col += _PoisonVeinColor * _PoisonGlow * hz * _PoisonShellHaze * poison * _PoisonIntensity * .35;
  }
  if (lightning > .001) {
    float on = lightningOn(t);
    float s = floor(t * _LightningFlickerRate);
    float sc = _LightningArcScale * 1.3;
    float w = (.004 + pw / _GlobalPatternScale * 1.5) * _LightningArcWidth;
    float arc = (1. - smoothstep(w * .4, w, isoDist(q * sc + s * 5.3 + h * 3.) / sc)) * smoothstep(.7, .78, vn3(q * 1.3 + s * 4.1));
    col += _LightningArcColor * _LightningGlow * arc * on * fade * _LightningShellArcs * lightning * _LightningIntensity;
  }
  if (spirit > .001) {
    float wisp = smoothstep(.6, .85, fbm3(q * 2. + float3(0., -t * _SpiritWispSpeed * 1.5, 0.))) * smoothstep(.3, .9, fres);
    // fade * fade: outer layers much fainter, so the discrete shells don't read as separate outlines
    col += _SpiritColor * (pow(fres, max(_SpiritRimPower - 1., 1.)) * .6 + wisp * .4) * fade * fade * _SpiritShellAura * spirit * _SpiritIntensity * .5;
  }
  comboShell(cid, cw, aw, q, n, v, pw / _GlobalPatternScale, fres, t, h, col, alpha);
  col *= _GlobalStrength * stackDim();
}

#endif
